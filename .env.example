# ===========================================
# Configuración de contacto - TechOPS
# ===========================================
# Copia este archivo como .env y ajusta los valores

# Correo de contacto
VITE_CONTACT_EMAIL=steed.galvez@gmail.com

# Teléfono (con código de país para WhatsApp)
VITE_CONTACT_PHONE=54649404
VITE_CONTACT_PHONE_DISPLAY=5464-9404
VITE_CONTACT_COUNTRY_CODE=502

# Nombre del negocio
VITE_BUSINESS_NAME=TechOPS
VITE_COMPANY_NAME=GCTechops

# Ubicación
VITE_BUSINESS_LOCATION=Guatemala

# Dominio
VITE_BUSINESS_DOMAIN=gctechops.com

# URL del sitio (para SEO)
VITE_SITE_URL=https://gctechops.com
VITE_SENTINEL_APP_URL=https://sentinel.gctechops.com

# Web3Forms Access Key (para envío de formularios de contacto)
# Genera tu key en https://web3forms.com/ con tu correo
VITE_WEB3FORMS_KEY=

# Agenda de diagnóstico (URL pública de Cal.com)
VITE_CAL_URL=

# Analítica privada. Si queda vacío, Plausible no se carga.
VITE_PLAUSIBLE_DOMAIN=

# URL alternativa del checklist. Vacía usa el PDF local incluido.
VITE_LEAD_MAGNET_URL=

# Precios iniciales aprobados en USD. Vacíos ocultan el precio.
VITE_PRICE_DIAGNOSTIC=
VITE_PRICE_OBSERVABILITY=
VITE_PRICE_PLATFORM=

# Perfil del especialista. La foto y LinkedIn son opcionales.
# Para añadir la foto: guarda el archivo en public/davis-galvez.jpg
# y configura VITE_FOUNDER_PHOTO=/davis-galvez.jpg
VITE_FOUNDER_NAME=Davis Galvez
VITE_FOUNDER_ROLE=Ingeniero de observabilidad e infraestructura
VITE_FOUNDER_PHOTO=
VITE_FOUNDER_LINKEDIN=
